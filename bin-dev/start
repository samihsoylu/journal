#!/usr/bin/env bash

set -e

# ==============================================================================
# Development Environment Startup Script
# ==============================================================================
# This script manages the development environment including:
# - Docker MariaDB container
# - PHP 8.5 built-in server
# - Composer dependencies
# - Doctrine migrations
# ==============================================================================

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
DOCKER_DIR="${SCRIPT_DIR}/docker"
CONTAINER_NAME="journal-mariadb"
RESET_DATABASE=false
HELP_REQUESTED=false
VERBOSE=false
PHP_SERVER_PORT=8080

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

# Symbols
CHECKMARK="${GREEN}✓${NC}"
CROSS="${RED}✗${NC}"
ARROW="${BLUE}→${NC}"

# ==============================================================================
# Print Functions
# ==============================================================================

print_status() {
    echo -e "${GRAY}  $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC}  $1"
}

print_error() {
    echo -e "${RED}✗${NC}  $1"
}

print_success() {
    echo -e "${CHECKMARK} $1"
}

print_step() {
    echo -e "\n${BLUE}▸${NC} $1"
}

print_section() {
    echo ""
    echo -e "${BLUE}==>${NC} $1"
    echo ""
}

print_verbose() {
    if [ "$VERBOSE" = true ]; then
        echo -e "${GRAY}    $1${NC}"
    fi
}

# Run command, show output only in verbose mode
run_cmd() {
    if [ "$VERBOSE" = true ]; then
        "$@"
    else
        "$@" >/dev/null 2>&1
    fi
}

# ==============================================================================
# Help Function
# ==============================================================================

show_help() {
    cat << EOF
Development Environment Startup Script

Usage: $0 [OPTIONS]

Options:
    --reset         Reset the database by removing Docker volumes
    --verbose, -v   Show detailed output for debugging
    --help, -h      Show this help message

Examples:
    $0                  # Start development environment
    $0 --reset          # Reset database and start
    $0 --verbose        # Start with detailed output

Description:
    This script manages the development environment by:
    1. Checking required dependencies (PHP 8.5, Composer, Docker)
    2. Starting MariaDB Docker container
    3. Installing Composer dependencies
    4. Running Doctrine migrations
    5. Starting PHP built-in development server

    Press Ctrl+C to stop all services.

EOF
}

# ==============================================================================
# Argument Parsing
# ==============================================================================

parse_args() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            --reset)
                RESET_DATABASE=true
                shift
                ;;
            --verbose|-v)
                VERBOSE=true
                shift
                ;;
            --help|-h)
                HELP_REQUESTED=true
                shift
                ;;
            *)
                print_error "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done
}

# ==============================================================================
# Cleanup Function
# ==============================================================================

cleanup() {
    echo ""
    echo ""
    print_step "Shutting down services..."

    # Stop PHP server
    if [ ! -z "$PHP_SERVER_PID" ] && kill -0 "$PHP_SERVER_PID" 2>/dev/null; then
        kill "$PHP_SERVER_PID" 2>/dev/null || true
    fi

    # Stop Docker container
    if docker ps -q -f name="$CONTAINER_NAME" >/dev/null 2>&1; then
        cd "$DOCKER_DIR"
        docker compose down >/dev/null 2>&1
    fi

    echo ""
    print_success "All services stopped"
    echo ""
    exit 0
}

# ==============================================================================
# Dependency Check Functions
# ==============================================================================

check_php() {
    if ! command -v php >/dev/null 2>&1; then
        print_error "PHP not installed"
        echo "Install PHP 8.5:"
        echo "  brew install php@8.5"
        echo "  brew link php@8.5 --force"
        exit 1
    fi

    # Check PHP version
    PHP_VERSION=$(php -r "echo PHP_MAJOR_VERSION . '.' . PHP_MINOR_VERSION;")
    if [[ "$PHP_VERSION" != "8.5" ]]; then
        print_warning "PHP ${PHP_VERSION} detected, but 8.5 is recommended"
        echo "Install PHP 8.5:"
        echo "  brew install php@8.5"
        echo "  brew link php@8.5 --force"
    else
        print_success "PHP 8.5"
    fi
}

check_composer() {
    if ! command -v composer >/dev/null 2>&1; then
        print_error "Composer not installed"
        echo "Install Composer:"
        echo "  brew install composer"
        exit 1
    fi

    print_success "Composer"
}

check_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        print_error "Docker not installed. Install from: https://docker.com/products/docker-desktop"
        exit 1
    fi

    if ! docker info >/dev/null 2>&1; then
        print_error "Docker not running. Start Docker Desktop first."
        exit 1
    fi

    print_success "Docker"
}

# ==============================================================================
# Docker Management Functions
# ==============================================================================

start_mariadb() {
    cd "$DOCKER_DIR"

    # Check if container is already running
    if docker ps -q -f name="$CONTAINER_NAME" | grep -q .; then
        print_success "MariaDB"
        return
    fi

    # Reset database if requested
    if [ "$RESET_DATABASE" = true ]; then
        print_step "Resetting database volumes..."
        run_cmd docker compose down -v
    fi

    # Start container
    print_step "Starting MariaDB..."
    run_cmd docker compose up -d

    # Wait for MariaDB to be healthy
    print_verbose "Waiting for MariaDB to be healthy..."
    local max_attempts=30
    local attempt=0

    while [ $attempt -lt $max_attempts ]; do
        if docker compose exec -T database healthcheck.sh --connect --innodb_initialized >/dev/null 2>&1; then
            print_verbose "MariaDB health check passed"
            break
        fi

        attempt=$((attempt + 1))
        print_verbose "Health check attempt $attempt/$max_attempts..."
        if [ $attempt -eq $max_attempts ]; then
            print_error "MariaDB failed to start"
            exit 1
        fi

        sleep 2
    done

    # Wait for init scripts to create journal user/database
    print_verbose "Waiting for journal user to be ready..."
    attempt=0
    while [ $attempt -lt $max_attempts ]; do
        if docker compose exec -T database mariadb -ujournal -pjournal -e "SELECT 1" >/dev/null 2>&1; then
            print_verbose "Journal user is ready"
            print_success "MariaDB"
            return
        fi

        attempt=$((attempt + 1))
        print_verbose "User check attempt $attempt/$max_attempts..."
        if [ $attempt -eq $max_attempts ]; then
            print_error "MariaDB user initialization failed"
            exit 1
        fi

        sleep 1
    done
}

# ==============================================================================
# Composer and Dependencies
# ==============================================================================

install_composer_dependencies() {
    cd "$PROJECT_ROOT"

    # Check if vendor directory exists
    if [ -d "vendor" ]; then
        print_success "Composer dependencies"
        return
    fi

    print_step "Installing composer dependencies..."
    run_cmd composer install

    if [ -d "vendor" ]; then
        print_success "Composer dependencies"
    else
        print_error "Failed to install composer dependencies"
        exit 1
    fi
}

# ==============================================================================
# Database Management
# ==============================================================================

create_test_database() {
    cd "$DOCKER_DIR"

    # Check if test database exists (journal user has access)
    if docker compose exec -T database mariadb -ujournal -pjournal -e "USE journal_test" >/dev/null 2>&1; then
        print_success "Test database (journal_test)"
        return
    fi

    # Database doesn't exist or journal user doesn't have access - create with root
    print_step "Creating test database..."
    print_verbose "Running: CREATE DATABASE IF NOT EXISTS journal_test (as root)"

    local output
    if output=$(docker compose exec -T database mariadb -uroot -proot -e "CREATE DATABASE IF NOT EXISTS journal_test; GRANT ALL PRIVILEGES ON journal_test.* TO 'journal'@'%'; FLUSH PRIVILEGES;" 2>&1); then
        print_verbose "Database created successfully"
    else
        print_verbose "Command output: $output"
        print_error "Failed to create test database"
        exit 1
    fi

    # Verify journal user can access the database
    if docker compose exec -T database mariadb -ujournal -pjournal -e "USE journal_test" >/dev/null 2>&1; then
        print_success "Test database (journal_test)"
    else
        print_error "Failed to grant access to test database"
        exit 1
    fi
}

execute_doctrine_migrations() {
    cd "$PROJECT_ROOT"

    if [ "$RESET_DATABASE" = true ]; then
        print_step "Resetting database..."
        # Drop all tables by running migrations down to version 0, then back up
        run_cmd ./vendor/bin/doctrine-migrations migrations:migrate first --no-interaction || true
    fi

    # Run migrations
    print_step "Running migrations..."
    run_cmd ./vendor/bin/doctrine-migrations migrations:migrate --no-interaction

    print_success "Database migrations"
}

execute_test_migrations() {
    cd "$PROJECT_ROOT"

    if [ "$RESET_DATABASE" = true ]; then
        print_step "Resetting test database..."
        APP_ENV=test run_cmd ./vendor/bin/doctrine-migrations migrations:migrate first --no-interaction || true
    fi

    # Run test migrations
    print_step "Running test migrations..."
    APP_ENV=test run_cmd ./vendor/bin/doctrine-migrations migrations:migrate --no-interaction

    print_success "Test database migrations"
}

create_env_file() {
    cd "$PROJECT_ROOT"

    if [ -f ".env" ]; then
        print_success ".env file"
        return
    fi

    print_step "Creating .env file..."
    cat > .env << 'EOF'
DEBUG_MODE = "true"
USE_SSL = "false"
BASE_URL = "/"
DB_HOST = "127.0.0.1"
DB_SCHEMA = "journal"
DB_USERNAME = "journal"
DB_PASSWORD = "journal"
SITE_TITLE = "Journal"
ADMIN_EMAIL_ADDRESS = "dev@example.com"
EOF

    print_success ".env file"
}

# ==============================================================================
# PHP Server Functions
# ==============================================================================

start_php_server() {
    cd "$PROJECT_ROOT"

    print_step "Starting PHP built-in server..."

    # Start PHP server in background
    if [ "$VERBOSE" = true ]; then
        php -S 127.0.0.1:${PHP_SERVER_PORT} -t public/ &
    else
        php -S 127.0.0.1:${PHP_SERVER_PORT} -t public/ >/dev/null 2>&1 &
    fi
    PHP_SERVER_PID=$!

    # Wait a moment for the server to start
    sleep 2

    # Verify server started
    if kill -0 "$PHP_SERVER_PID" 2>/dev/null; then
        print_success "PHP Server"
    else
        print_error "Failed to start PHP server"
        exit 1
    fi
}

# ==============================================================================
# Main Execution
# ==============================================================================

main() {
    # Check if running on macOS
    if [[ "$OSTYPE" != "darwin"* ]]; then
        print_error "This script is optimized for macOS."
        echo "Current OS: $OSTYPE"
        echo "You may need to adjust dependency checks for your platform."
    fi

    # Parse arguments
    parse_args "$@"

    # Show help if requested
    if [ "$HELP_REQUESTED" = true ]; then
        show_help
        exit 0
    fi

    # Set up trap for cleanup
    trap cleanup SIGINT SIGTERM

    # Welcome message
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  🚀 Journal - Development Environment"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    # Check dependencies
    check_php
    check_composer
    check_docker

    echo ""

    # Start services
    start_mariadb
    create_env_file
    install_composer_dependencies
    execute_doctrine_migrations
    create_test_database
    execute_test_migrations
    start_php_server

    # Success message with summary
    echo ""
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e "  ${GREEN}✓${NC} Development Environment Ready!"
    echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo -e "  ${BLUE}📦 MariaDB${NC}"
    echo -e "     Host:     ${GREEN}127.0.0.1:3306${NC}"
    echo -e "     Database: ${GREEN}journal${NC}"
    echo -e "     User:     ${GREEN}journal${NC}"
    echo -e "     Password: ${GREEN}journal${NC}"
    echo ""
    echo -e "  ${BLUE}🌐 PHP Development Server${NC}"
    echo -e "     URL:      ${GREEN}http://127.0.0.1:${PHP_SERVER_PORT}${NC}"
    echo ""
    echo -e "  ${GRAY}Press Ctrl+C to stop all services${NC}"
    echo ""

    # Keep script running
    while true; do
        sleep 1
    done
}

# Run main function
main "$@"
