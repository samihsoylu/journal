# Test Environment Configuration
# Uses the same Docker MariaDB instance as development

# Site Configuration
SITE_TITLE="Journal Test"
BASE_URL=http://localhost:8080

# Test Database (created automatically by bin-dev/start)
DB_HOST=127.0.0.1
DB_SCHEMA=journal_test
DB_USERNAME=journal
DB_PASSWORD=journal

# Debug Mode
DEBUG_MODE=true
USE_SSL=false

# Admin
ADMIN_EMAIL_ADDRESS=test@example.com
