{
    "name": "samihsoylu/journal",
    "description": "Document your life, daily happenings, special occasions, and reflections on your goals.",
    "type": "project",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Samih Soylu",
            "email": "mail@samihsoylu.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "private/lib/",
            "App\\Framework\\": "private/framework/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": false,
            "php-http/discovery": true
        }
    },
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-zip": "*",
        "doctrine/orm": "^3.0",
        "vlucas/phpdotenv": "^5.4",
        "illuminate/view": "^13.38",
        "nikic/fast-route": "^1.3",
        "symfony/cache": "^8.1",
        "psr/cache": "^3.0",
        "erusev/parsedown": "^1.7",
        "defuse/php-encryption": "^2.2",
        "doctrine/migrations": "^3.1",
        "symfony/console": "^8.0",
        "sentry/sdk": "^4.0",
        "php-di/php-di": "^7.0",
        "symfony/var-exporter": "^8.1",
        "symfony/html-sanitizer": "^8.1",
        "symfony/rate-limiter": "^8.1",
        "symfony/lock": "^8.1",
        "spomky-labs/otphp": "^11.5",
        "symfony/clock": "^8.1"
    },
    "require-dev": {
        "roave/security-advisories": "dev-master",
        "phpunit/phpunit": "^13.4",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.4",
        "phpstan/phpstan": "^2.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "rector/rector": "^2.2",
        "symfony/var-dumper": "^8.0"
    }
}
